# Base URL of the deployed Next.js app — this service forwards messages to
# its existing /api/assistant/quote and polls /api/assistant/book-hold/[id].
# No trailing slash.
MAIN_APP_URL=http://localhost:3000

# Port for this service's own health-check endpoint (GET /internal/health).
# Not used for anything WhatsApp-related — Baileys makes an outbound
# connection, it doesn't listen for inbound WhatsApp traffic.
PORT=4200

# Case-insensitive phrase that must appear in a GROUP message before the bot
# responds. Direct 1:1 messages to the bot's own number always get a
# response regardless of this trigger, since they're already addressed to it.
BOT_MENTION_TRIGGER=@tdisbot
