// Prisma schema for the Airline Connector Framework.
//
// This is intentionally a separate data store from the rest of the app
// (which uses Firestore/localStorage — see src/lib/store.tsx). Wallet sync
// data is structured, relational, and needs transactional history — a good
// fit for Postgres. After a successful sync, SyncService also mirrors the
// current balance into the existing Firestore `balances` document so the
// Airlines/Balances UI updates without any client-side changes (see
// src/modules/airline-connectors/services/SyncService.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection — PgBouncer/Neon's
  // pooler doesn't support the session-level operations `prisma migrate`
  // needs. The app's actual runtime queries keep using the pooled
  // DATABASE_URL above (better for serverless), this is only used by the
  // Prisma CLI for migrate/introspect.
  directUrl = env("DIRECT_URL")
}

enum AirlineKey {
  AIRPEACE
  AERO
  ARIK
  IBOM
  NGEAGLE
  // Category B — all four now implemented on the shared VARS/Videcom
  // connector base (see connectors/vars/BaseVarsConnector.ts).
  UNITED
  RANO
  ENUGU
  XEJET
  // KIU-platform agent portal (kiu.click) — separate from ValueJet's own
  // public B2C booking site (flyvaluejet.com), which flight-search uses.
  VALUEJET
}

enum CabinClass {
  ECONOMY
  // Compares every Premium Economy/Premium Economy Flex/Business/Business
  // Flex fare found on the page and books the cheapest available one — see
  // selectCheapestFare's category mode in VarsBookOnHold.ts.
  PREMIUM
}

enum SyncStatus {
  SUCCESS
  FAILED
  IN_PROGRESS
  PENDING
}

enum SyncTrigger {
  MANUAL
  SCHEDULED
}

enum ErrorCategory {
  AUTH
  NETWORK
  PORTAL
  UNKNOWN
}

// Current balance + metadata for each airline (updated on successful sync).
model AirlineWallet {
  id              String     @id @default(cuid())
  airline         AirlineKey @unique

  // === BALANCE DATA ===
  currentBalance  Decimal    @default(0) @db.Decimal(14, 2)
  previousBalance Decimal?   @db.Decimal(14, 2)  // For UI comparison
  currency        String     @default("NGN")

  // === SYNC METADATA ===
  lastSynced      DateTime?
  lastStatus      SyncStatus @default(PENDING)
  lastRunId       String?    // Latest sync attempt (for polling)

  // === CACHE (from most recent AirlineBalanceHistory) ===
  lastSuccessfulSync DateTime?
  lastFailedSync     DateTime?
  failureCount       Int        @default(0)       // Cumulative failures
  consecutiveFailures Int       @default(0)       // Failures in a row

  updatedAt       DateTime   @updatedAt
  createdAt       DateTime   @default(now())

  history  AirlineBalanceHistory[]
  settings AirlineConnectorSettings?

  @@map("airline_wallets")
}

// Append-only. A sync NEVER overwrites a previous record — every run
// (successful or failed) inserts a new row, so balance history and audit
// trail are always intact.
model AirlineBalanceHistory {
  id           String       @id @default(cuid())
  airline      AirlineKey

  // === BALANCE DATA ===
  balance      Decimal      @db.Decimal(14, 2)
  previousBalance Decimal?  @db.Decimal(14, 2)
  balanceChange Decimal?    @db.Decimal(14, 2)  // Computed: balance - previousBalance
  currency     String       @default("NGN")

  // === SYNC METADATA ===
  runId        String?      // Group all airlines from one sync run
  retrievedAt  DateTime     @default(now())
  syncStatus   SyncStatus
  connector    String       // e.g., "AirPeaceConnector"
  trigger      SyncTrigger  @default(MANUAL)
  durationMs   Int?         // How long the sync took

  // === ERROR CATEGORIZATION ===
  errorCategory ErrorCategory?
  errorMessage  String?
  errorCode     String?     // e.g., "INVALID_PASSWORD", "TIMEOUT"

  // === INITIATIVE TRACKING ===
  initiatedBy   String?     // "admin@example.com" or "scheduler"

  createdAt    DateTime     @default(now())

  wallet AirlineWallet @relation(fields: [airline], references: [airline])

  @@index([airline, retrievedAt])
  @@index([runId])
  @@index([syncStatus])
  @@index([errorCategory])
  @@map("airline_balance_history")
}

// Per-airline connector configuration, managed from Admin → Airline Connectors.
// `encryptedUsername`/`encryptedPassword` are AES-256-GCM ciphertext (see
// CredentialService) — plaintext credentials are never persisted or sent to
// the frontend. This is for ADMIN/SYNC credentials only, NOT user credentials.
model AirlineConnectorSettings {
  id                  String     @id @default(cuid())
  airline             AirlineKey @unique
  enabled             Boolean    @default(false)
  encryptedUsername   String?    // Admin sync account
  encryptedPassword   String?    // Admin sync account

  // === SYNC SCHEDULE ===
  syncIntervalMinutes Int?       // 15, 30, 60, 120, 1440, etc. (NULL = manual only)
  dailyRunAtUtc       String?    // "00:00", "12:00", etc.

  // === AUTH FAILURE TRACKING ===
  authFailureCount    Int?       @default(0)
  authFailureSince    DateTime?
  authCooldownUntil   DateTime?
  passwordUpdatedAt   DateTime?  // Triggers cooldown clear

  // === RETRY BEHAVIOR CONFIG ===
  maxRetryAttempts    Int        @default(3)
  baseRetryDelayMs    Int        @default(1000)

  // === PERFORMANCE CONFIG ===
  syncTimeoutSeconds  Int        @default(60)   // Max time to spend on one airline
  maxConcurrentSyncs  Int        @default(3)    // Per scheduler run

  // === COOLDOWN CONFIG ===
  authCooldownMinutes Int        @default(300)  // 5 hours, configurable
  networkErrorBackoffMinutes Int @default(5)    // Retry network errors after 5 min
  portalErrorBackoffMinutes  Int @default(30)   // Retry portal errors after 30 min

  // === METADATA ===
  connectionStatus    String     @default("NOT_CONFIGURED")
  lastTestedAt        DateTime?
  updatedAt           DateTime   @updatedAt
  createdAt           DateTime   @default(now())

  wallet AirlineWallet @relation(fields: [airline], references: [airline])

  @@map("airline_connector_settings")
}

// Structured sync logs — Login Started, Login Success, Navigation, Balance
// Retrieved, Balance Saved, Logout, Errors — one row per event, per run.
model AirlineSyncLog {
  id        String     @id @default(cuid())
  runId     String
  airline   AirlineKey?

  step      String     // e.g. LOGIN_STARTED, LOGIN_SUCCESS, BALANCE_RETRIEVED, ERROR
  message   String
  level     String     @default("info") // info | warn | error

  // === ERROR DETAILS ===
  errorCategory ErrorCategory?
  errorCode     String?

  createdAt DateTime   @default(now())

  run AirlineSyncRun @relation(fields: [runId], references: [runId])

  @@index([airline, runId])
  @@map("airline_sync_logs")
}

// Aggregates one sync run (all airlines in that run).
// Groups all log lines and results for a single sync orchestration.
model AirlineSyncRun {
  id            String   @id @default(cuid())
  runId         String   @unique

  // === WHEN & WHO ===
  trigger       SyncTrigger
  initiatedBy   String?  // "admin@example.com" or "scheduler"
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  durationMs    Int?     // Computed on completion

  // === RESULTS SUMMARY ===
  totalAirlines     Int
  successfulCount   Int     @default(0)
  failedCount       Int     @default(0)
  skippedCount      Int     @default(0)  // Due to cooldown or disabled

  // === ERROR BREAKDOWN ===
  authFailureCount  Int     @default(0)
  networkFailureCount Int   @default(0)
  portalFailureCount Int    @default(0)
  unknownFailureCount Int   @default(0)

  // === CONCURRENCY INFO ===
  parallelism       Int     @default(1)

  createdAt    DateTime   @default(now())

  logs AirlineSyncLog[]

  @@map("airline_sync_runs")
}

// Global and per-module configuration (configurable without code changes).
model AppConfig {
  id        String @id @default(cuid())
  module    String // "airline-connectors"
  key       String // "authCooldownMinutes", "defaultSyncInterval", etc.
  value     String // JSON stringified

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([module, key])
  @@map("app_config")
}

// ─── AI Travel Assistant (chat bubble) ───
// One row per distinct chat session — keyed either by the Firebase auth
// uid (logged-in users) or a browser-generated anonymous id persisted in
// localStorage (guest/demo users). `slots` holds the short-term memory the
// conversation orchestrator fills in turn by turn (origin, destination,
// date, pax, etc.) so the assistant only asks for what's still missing.
model ChatSession {
  id              String   @id @default(cuid())
  sessionKey      String   @unique
  displayName     String?
  isAuthenticated Boolean  @default(false)
  userId          String? // Firebase UID if authenticated
  slots           Json?
  // Small deterministic command state machines OUTSIDE the booking-flow
  // `slots` above — currently just an in-progress /settings account
  // selection (see handleSettingsCommand.ts). Deliberately a separate
  // column so a booking-flow reset never has to know about /settings
  // state and vice versa; the CANCEL/RESET handler clears both explicitly.
  pendingAction   Json?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @updatedAt

  messages      ChatMessage[]
  searches      FlightSearchRecord[]
  notifications AppNotification[]

  @@map("chat_sessions")
}

enum ChatRole {
  USER
  ASSISTANT
}

// Append-only turn log. `intent`/`entities` are populated only when the
// LLM path ran (see ConversationOrchestrator) — null on the deterministic
// fallback path used when GROQ_API_KEY isn't configured.
model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      ChatRole
  text      String
  intent    String?
  entities  Json?
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// One row per completed search (a leg, not a whole round-trip — a
// round-trip produces two rows, one per direction, so each leg gets its
// own reference ID and can be reopened independently). `resultsJson` is
// a full FlightSearchResult snapshot so a reopened search shows exactly
// what the agent originally quoted, not a live re-search that might
// return different prices later.
model FlightSearchRecord {
  id          String   @id @default(cuid())
  referenceId String   @unique
  sessionId   String
  origin      String
  destination String
  date        String
  airlines    String[]
  resultCount Int
  resultsJson Json
  createdAt   DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, createdAt])
  @@map("flight_search_records")
}

// In-app notification center. One row per event worth surfacing to the
// user (quote generated, search saved, system alert). Persisted (not just
// client-side state) so notifications survive reloads/new tabs and can be
// polled from any device signed into the same session.
model AppNotification {
  id        String   @id @default(cuid())
  sessionId String
  kind      String // QUOTE_GENERATED | SYSTEM_ALERT | BOOKING_CREATED | TICKET_ISSUED
  title     String
  body      String
  link      Json? // arbitrary click-through payload (e.g. { referenceId, bookingId })
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, createdAt])
  @@map("app_notifications")
}

// ─── AI Sales Reporting ───
// Staff appear in reservation-software exports as opaque user codes
// (e.g. "TDISLOGIST-FLORENCE AINA") — this is the learned mapping to the
// short display name reports actually use (e.g. "FLORENCE"). Stored in
// the DB rather than hardcoded so new codes/staff can be taught without a
// deploy. Similar-but-distinct names (OLABISI vs AKANBI) are always
// separate rows — nothing here ever merges two raw codes into one
// display name automatically.
model StaffAlias {
  id          String   @id @default(cuid())
  rawCode     String   @unique
  displayName String
  createdAt   DateTime @default(now())

  @@map("staff_aliases")
}

enum SalesReportStatus {
  PENDING_VERIFICATION
  SAVED
}

// One row per generated daily report. Left in PENDING_VERIFICATION until
// the user explicitly confirms ("Reply Save"), matching the required
// verify-before-save flow — nothing is queryable/counted toward
// weekly/monthly rollups until it's SAVED.
model SalesReport {
  id           String            @id @default(cuid())
  airline      AirlineKey
  reportDate   String // "DD/MM/YY" as shown in the report text, so formatting is exact and stable
  grandTotal   Decimal           @db.Decimal(14, 2)
  confidence   Float // 0-1; the report generation flow asks the user to review specific transactions below 0.9
  reportText   String // the exact rendered report, so re-displaying it later never depends on re-deriving formatting
  sourceFiles  Json // array of { name, url, kind: "EXCEL" | "SCREENSHOT" } — the uploaded originals, for audit
  rulesVersion String // which rule-engine version produced this report, so a later rule change doesn't retroactively change historical reports' meaning
  createdBy    String?
  verifiedBy   String?
  status       SalesReportStatus @default(PENDING_VERIFICATION)
  createdAt    DateTime          @default(now())
  verifiedAt   DateTime?

  // NEW FIELDS - PHASE 1: Airline detection & tracking
  airlineDetectedBy      String?     // Method: "MANUAL" | "CONTENT" | "FORMAT" | "METADATA" | "VISION"
  detectionConfidence    Float?      // 0-1 confidence score
  detectionReasoning     String[]    // Why this airline was detected (for debugging)
  fileHash               String?     // SHA-256 hex (for exact duplicate detection)
  originalFilename       String?     // Original uploaded filename
  fileSize               Int?        // Bytes (to track large files)
  importedAt             DateTime?   // When user uploaded this file
  importedBy             String?     // Firebase UID
  supersededById         String?     // If overwritten, which report replaced this
  supersededAt           DateTime?   // When it was superseded
  supersededBy           String?     // User ID who approved supersession

  staffSales   StaffSales[]
  transactions SalesTransaction[]
  tickets      SalesTicket[]
  analytics    SalesReportAnalytics?

  @@index([airline, reportDate, status])
  @@index([fileHash])
  @@index([importedAt])
  @@index([supersededById])
  @@map("sales_reports")
}

// Per-staff (and SYSTEM) subtotal for one report — the numbers the report
// text itself shows under each name.
model StaffSales {
  id               String  @id @default(cuid())
  reportId         String
  staffName        String
  amount           Decimal @db.Decimal(14, 2)
  transactionCount Int

  report SalesReport @relation(fields: [reportId], references: [id])

  @@index([reportId])
  @@map("staff_sales")
}

// Every parsed row from the source file, whether it ended up counted or
// not — this is what the verification checklist's "included/ignored"
// lists are built from, and what lets a future audit re-derive exactly
// why a number is what it is.
model SalesTransaction {
  id           String  @id @default(cuid())
  reportId     String
  staffName    String
  amount       Decimal @db.Decimal(14, 2)
  paymentType  String // bare source code: "PT", "PM", "CL", or "RT" — deposits/commission-paybacks aren't distinct types, they're PM rows with descriptive text in the source's own definition column
  mcoReference String?
  pnr          String?
  user         String // the raw reservation-software user code before alias mapping
  rawRecord    String // original row text/line, verbatim, for audit
  status       String // e.g. "INCLUDED", "IGNORED_PM", "IGNORED_CREDIT", "IGNORED_RT", "CANCELLED_BY_RT", "IGNORED_OTHER"

  report SalesReport @relation(fields: [reportId], references: [id])

  @@index([reportId])
  @@map("sales_transactions")
}

// Denormalized ticket-level record — one row per PT-type transaction
// (included or excluded), independent of the daily report text. This is
// the source weekly/monthly/staff-analytics rollups query directly
// (SUM/COUNT/GROUP BY) instead of re-parsing report text.
model SalesTicket {
  id               String     @id @default(cuid())
  reportId         String
  airline          AirlineKey
  date             String // "DD/MM/YY", matching reportDate
  staff            String
  pnr              String?
  mcoReference     String?
  ticketValue      Decimal    @db.Decimal(14, 2)
  paymentType      String
  status           String
  included         Boolean
  reasonIfExcluded String?
  createdAt        DateTime   @default(now())

  // NEW FIELDS - PHASE 1: Enhanced metrics for analytics
  grossSalesAmount   Decimal? @db.Decimal(14, 2)  // Before deductions
  netSalesAmount     Decimal? @db.Decimal(14, 2)  // After deductions
  commission         Decimal? @db.Decimal(14, 2)
  refundAmount       Decimal? @db.Decimal(14, 2)
  admAmount          Decimal? @db.Decimal(14, 2)
  bspAmount          Decimal? @db.Decimal(14, 2)

  report SalesReport @relation(fields: [reportId], references: [id])

  @@index([airline, date])
  @@index([staff])
  @@index([reportId])
  @@map("sales_tickets")
}

// ─── NEW PHASE 1: Sales Analytics Tables ───
// Pre-calculated KPI summary per report for fast dashboard queries
model SalesReportAnalytics {
  id                    String      @id @default(cuid())
  reportId              String      @unique
  airline               AirlineKey
  reportDate            String      // "DD/MM/YYYY"
  reportingPeriod       String?     // e.g., "Jul 2024"
  reportingPeriodStart  String?     // Start date of period
  reportingPeriodEnd    String?     // End date of period

  // Executive KPIs - All required for dashboard
  totalTicketsIssued    Int         // PT count (included)
  totalTicketsVoided    Int         // Voided tickets
  totalVoidAmount       Decimal @db.Decimal(14, 2)
  totalCreditAmount     Decimal @db.Decimal(14, 2)
  totalDebitAmount      Decimal @db.Decimal(14, 2)
  grossSalesAmount      Decimal @db.Decimal(14, 2)  // Before deductions
  netSalesAmount        Decimal @db.Decimal(14, 2)  // After deductions
  totalCommission       Decimal @db.Decimal(14, 2)

  // Airline-specific metrics (optional)
  bspValues             Decimal? @db.Decimal(14, 2)
  refundValues          Decimal? @db.Decimal(14, 2)
  admValues             Decimal? @db.Decimal(14, 2)

  createdAt             DateTime    @default(now())

  report                SalesReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([airline, reportDate])
  @@index([airline, reportingPeriodStart, reportingPeriodEnd])
  @@map("sales_report_analytics")
}

// Track report supersessions and maintain audit trail
model ReportDuplicateHistory {
  id                    String      @id @default(cuid())
  originalReportId      String      // Report that was replaced
  supersededById        String?     // Which report replaced it (null if discarded)
  airline               AirlineKey
  reportDate            String      // "DD/MM/YYYY"

  // Status and tracking
  originalStatus        SalesReportStatus  // PENDING_VERIFICATION or SAVED
  replacedAt            DateTime?   // When replacement happened
  replacedBy            String?     // User ID who approved
  replacementReason     String?     // Why it was replaced

  createdAt             DateTime    @default(now())

  @@index([airline, reportDate])
  @@index([originalReportId])
  @@index([supersededById])
  @@map("report_duplicate_history")
}

// Denormalized daily staff metrics for fast staff analytics queries
model StaffDailyPerformance {
  id                    String      @id @default(cuid())
  date                  String      // "DD/MM/YYYY"
  airline               AirlineKey
  staffName             String      // Resolved display name (e.g., "FLORENCE")

  // Metrics (calculated from SalesTicket)
  ticketsIssued         Int         // Count of tickets
  salesAmount           Decimal @db.Decimal(14, 2)
  commission            Decimal @db.Decimal(14, 2)
  voidAmount            Decimal @db.Decimal(14, 2)
  creditAmount          Decimal @db.Decimal(14, 2)

  createdAt             DateTime    @default(now())

  @@unique([date, airline, staffName])
  @@index([airline, date])
  @@index([staffName, date])
  @@index([date])  // For "top staff today" queries
  @@map("staff_daily_performance")
}

// Daily airline totals for trend analysis
model AirlineDailyMetrics {
  id                    String      @id @default(cuid())
  date                  String      // "DD/MM/YYYY"
  airline               AirlineKey

  // Totals (calculated from reports)
  totalSales            Decimal @db.Decimal(14, 2)
  totalTickets          Int
  totalVoids            Int
  totalVoidAmount       Decimal @db.Decimal(14, 2)
  netSales              Decimal @db.Decimal(14, 2)

  createdAt             DateTime    @default(now())

  @@unique([date, airline])
  @@index([airline, date])
  @@index([date])  // For "today's totals by airline"
  @@map("airline_daily_metrics")
}

// ─── Book-on-Hold jobs ───
// A real Book-on-Hold is a multi-minute Playwright run on connector-service,
// well past what a Vercel function (~60s) can hold open. So a client (the
// chat today, or a future WhatsApp/mobile/3rd-party integration) creates a
// job row via the REST API, connector-service runs the automation and writes
// the outcome (PNR, screenshot, PDF, or a categorized error) back here, and
// the client polls until it's terminal. Screenshot and PDF are stored inline
// as bytea — low volume, and keeping them with the job row avoids standing up
// a separate blob store. Passenger PII lives here because a booking record
// inherently needs it; it is never written to logs.
enum BookingJobStatus {
  PENDING // created, not yet picked up
  RUNNING // connector-service is executing the automation
  SUCCESS // PNR generated (hold created, but not yet issued/paid)
  FAILED // see errorCategory/errorMessage
  // Best-effort user-initiated CANCEL/RESET/ABORT/STOP while still PENDING
  // (queued) or RUNNING. A job that had already placed a real hold on the
  // airline's own portal by the time this was noticed is still marked
  // CANCELLED (never silently reported as SUCCESS) but keeps its
  // pnr/holdExpiresAt populated — see BookingJobRepository.recordCancelledButCompleted.
  CANCELLED
}

// User-friendly buckets the automation maps raw failures into (so the chat
// never shows a raw stack trace).
enum BookingErrorCategory {
  LOGIN_FAILED
  SESSION_EXPIRED
  PORTAL_UNAVAILABLE
  SEAT_UNAVAILABLE
  INVALID_PASSENGER
  ROUTE_NOT_SERVED
  UNKNOWN
}

enum TicketStatus {
  BOOKED // Hold created, not yet issued
  ISSUING // Issue-ticket automation currently running — no longer set by any
  // in-app code (the ticket-issuing automation was removed), kept in the
  // enum only because past rows may still hold this value.
  ISSUED // Payment completed, ticket issued
  VOIDED // Ticket was voided
  EXPIRED // Hold expired without payment
}

// Fine-grained progress within a RUNNING (or QUEUED, waiting on) booking job
// — see connector-service's EnuguWorkerPool.ts and VarsBookOnHold.ts's
// onStage callback for where each value gets set. QUEUED is set while the
// job is waiting for a free worker (never during actual automation);
// everything else fires in order as the Playwright automation progresses.
// Purely additive to BookingJobStatus, not a replacement — status still
// carries PENDING/RUNNING/SUCCESS/FAILED, this just adds detail while
// RUNNING (or ahead of it, while queued).
enum BookingStage {
  QUEUED
  SEARCHING
  FLIGHT_FOUND
  FILLING_PASSENGER_DETAILS
  REVIEWING_ITINERARY
  CREATING_HOLD
}

model BookingJob {
  id         String           @id @default(cuid())
  status     BookingJobStatus @default(PENDING)
  airline    AirlineKey
  sessionKey String? // which chat session (or API client) requested it
  userId     String? // Firebase UID of the user who created this booking

  // Request
  origin        String
  destination   String
  departureDate String // "YYYY-MM-DD"
  returnDate    String? // omit for one-way
  title         String  @default("Mr")
  firstName     String
  lastName      String
  phone         String?
  email         String?
  // Passengers beyond the lead one above, same PNR — each is
  // {type: "ADULT"|"CHILD"|"INFANT", title, firstName, lastName, dateOfBirth?}
  // ("type" defaults to ADULT when absent, for rows written before this
  // field existed). Adults share the lead passenger's phone/email; child
  // and infant passengers need neither (the portal's per-passenger form
  // only exposes Title/Name/Date of Birth for those types — confirmed via
  // the child/infant tutorial recording) but DO need dateOfBirth, since the
  // portal enforces the age band via the date-picker's allowed year range.
  // Null/empty for a single-passenger hold (unchanged default).
  additionalPassengers Json?
  cabinClass           CabinClass @default(ECONOMY)

  // Ticket-issuing lifecycle columns — the automation that wrote these was
  // removed (see VarsIssueTicket.ts's deletion), but the columns and their
  // historical data are kept rather than dropped; no in-app code reads or
  // writes them anymore.
  ticketStatus     TicketStatus @default(BOOKED)
  ticketNumber     String?
  issueStartedAt   DateTime?
  issuedAt         DateTime?
  issueError       String?
  // Which specific flight to book on each leg, when that leg's route/date
  // has more than one — resolved by the chat before the job is created
  // (search count -> ask the user if needed). Null means "known to have
  // exactly one flight" (or the disambiguation check itself failed and the
  // automation falls back to its default first-panel behavior).
  preferredDepartureTime String?
  preferredReturnTime    String?

  // Worker-pool progress — see BookingStage above. queuePosition is only
  // meaningful while stage is QUEUED (1-based; the poller derives an
  // estimated wait from it) and is cleared once the job actually starts.
  stage         BookingStage?
  queuePosition Int?

  // Result (populated on SUCCESS)
  pnr           String?
  holdExpiresAt String?
  totalPayable  Decimal? @db.Decimal(14, 2)
  currency      String?
  screenshot    Bytes? // PNG of the confirmation page (PNR + passenger visible)
  pdf           Bytes? // generated TDIS confirmation PDF

  // Failure (populated on FAILED)
  errorCategory BookingErrorCategory?
  errorMessage  String?

  createdBy  String?
  durationMs Int?
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  // Relationship to user bookings (for history/retrieval)
  userBooking UserBooking?

  @@index([sessionKey, createdAt])
  @@index([status])
  @@index([userId])
  @@index([pnr])
  @@index([ticketStatus])
  @@map("booking_jobs")
}

// One row per configured Enugu Air booking account (see connector-service's
// EnuguWorkerPool.ts). Mutual exclusion lives HERE, not just in the pool's
// in-memory state — Railway's rolling deploys briefly run the OLD and NEW
// connector-service process at once (confirmed live: this in-memory-only
// gap let two processes both claim the same account simultaneously and
// collide mid-booking). Postgres is the one thing every process actually
// shares, so an atomic conditional UPDATE here (claimedByJobId IS NULL ->
// this job's id) is the real lock; the in-memory pool just decides who's
// waiting in line, not who's allowed to touch the account right now.
// SUPERSEDED (2026-08-14) by AirlineWorkerSlot below — kept in the schema,
// unused by any code path, purely as an instant rollback net (its rows were
// copied, not moved, into airline_worker_slots by the accompanying data
// migration). Do not write new code against this model.
model EnuguWorkerSlot {
  id             String    @id @default(cuid())
  accountLabel   String    @unique
  claimedByJobId String?
  claimedAt      DateTime?
  updatedAt      DateTime  @updatedAt

  @@map("enugu_worker_slots")
}

// Generalizes EnuguWorkerSlot across every bookable airline — one row per
// configured login (from <AIRLINE>_BOOKING_ACCOUNTS on Railway), claimed
// atomically (a single conditional updateMany, not read-then-write) so two
// connector-service processes — including the brief old/new overlap during
// a Railway rolling deploy — can never both believe they hold the same
// account. See connector-service/src/AirlineWorkerPool.ts.
model AirlineWorkerSlot {
  id             String     @id @default(cuid())
  airline        AirlineKey
  accountLabel   String
  claimedByJobId String?
  claimedAt      DateTime?
  updatedAt      DateTime   @updatedAt

  @@unique([airline, accountLabel])
  @@map("airline_worker_slots")
}

// Per-WhatsApp-number (sessionKey), per-airline preferred login account —
// set via /settings, read by connector-service's book-hold route before
// submitting a job to AirlineWorkerPool. No row for a given
// [sessionKey, airline] means "no preference saved" -> the pool falls back
// to its own default (any free account for ENUGU, the first configured
// account for every other airline — see AirlineWorkerPool.submit).
model UserAirlineAccountPreference {
  id           String     @id @default(cuid())
  sessionKey   String
  airline      AirlineKey
  accountLabel String
  updatedAt    DateTime   @updatedAt
  createdAt    DateTime   @default(now())

  @@unique([sessionKey, airline])
  @@map("user_airline_account_preferences")
}

// ─── User Credentials & Booking History ───
// Each user can save their own airline credentials (encrypted).
// This allows booking automation to use the user's own account, not admin credentials.
model UserAirlineCredential {
  id                  String     @id @default(cuid())
  userId              String     // Firebase UID
  airline             AirlineKey
  encryptedUsername   String     // AES-256-GCM ciphertext
  encryptedPassword   String     // AES-256-GCM ciphertext
  connectionStatus    String     @default("CONFIGURED") // CONFIGURED | ERROR
  lastTestedAt        DateTime?
  lastTestError       String?
  updatedAt           DateTime   @updatedAt
  createdAt           DateTime   @default(now())

  userBookings UserBooking[]

  @@unique([userId, airline])
  @@index([userId, airline])
  @@map("user_airline_credentials")
}

// User's booking history — one row per saved/issued booking.
// Links a BookingJob with a user so they can retrieve and act on it later.
model UserBooking {
  id         String       @id @default(cuid())
  userId     String       // Firebase UID
  jobId      String       @unique // Reference to BookingJob
  pnr        String       // Denormalized from job for quick search
  airline    AirlineKey
  status     TicketStatus @default(BOOKED) // BOOKED | ISSUED | VOIDED | EXPIRED

  // Timestamps
  bookedAt   DateTime @default(now())
  issuedAt   DateTime? // When ticket was issued (paid)
  voidedAt   DateTime?
  expiresAt  DateTime? // When the hold expires

  // Issue/Void job tracking
  issueJobId String? // Reference to subsequent BookingJob for issuing
  voidJobId  String? // Reference to subsequent BookingJob for voiding

  // Relationship back to the booking job
  job BookingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Relationship to the user's credentials (to know which account issued this)
  credential UserAirlineCredential? @relation(fields: [userId, airline], references: [userId, airline])

  @@index([userId, bookedAt])
  @@index([userId, pnr])
  @@index([airline])
  @@index([status])
  @@map("user_bookings")
}

// Track PNR verification attempts (for audit/debugging)
model PnrVerification {
  id             String   @id @default(cuid())
  pnr            String
  airline        AirlineKey
  passengerName  String
  verified       Boolean
  verifiedAt     DateTime @default(now())
  errorMessage   String?
  verificationMs Int? // How long verification took

  @@index([pnr, airline])
  @@index([verifiedAt])
  @@map("pnr_verifications")
}
